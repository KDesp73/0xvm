# Makefile for process-migration (generated by scaffold, root orchestrator)
.DEFAULT_GOAL := help

CC      ?= gcc
CFLAGS  ?= -Wall -Wextra
LDFLAGS ?=

SRC_DIR     = src
INCLUDE_DIR = include
BUILD_DIR   = build
TEST_DIR    = tests
APPS_DIR    = apps
LIBS_DIR    = libs
DEPS_DIR    = deps

TARGET  = process-migration
VERSION = 0.1.0

SRC = $(wildcard $(SRC_DIR)/*.c)
OBJ = $(patsubst $(SRC_DIR)/%.c,$(BUILD_DIR)/%.o,$(SRC))
DEP = $(OBJ:.o=.d)

TEST_SRC = $(wildcard $(TEST_DIR)/*.c)
TEST_OBJ = $(patsubst $(TEST_DIR)/%.c,$(BUILD_DIR)/test_%.o,$(TEST_SRC))
TEST_DEP = $(TEST_OBJ:.o=.d)

APP_NAMES = $(notdir $(wildcard $(APPS_DIR)/*))
APPS      = $(addprefix vm-,$(APP_NAMES))
LIBS      = $(notdir $(wildcard $(LIBS_DIR)/*))
LIB_ARCH  = $(foreach lib,$(LIBS),$(LIBS_DIR)/$(lib)/lib$(lib).a)

CFLAGS += -I$(INCLUDE_DIR) $(foreach lib,$(LIBS),-I$(LIBS_DIR)/$(lib)/include) -MMD -MP
CFLAGS  += -I$(DEPS_DIR) -I$(TEST_DIR)
LDFLAGS += 

# Profile: `make type=RELEASE` for an optimized build
ifeq ($(type), RELEASE)
	CFLAGS += -O3 -DNDEBUG
else
	SANITIZERS = -fsanitize=address,undefined
	CFLAGS  += -DDEBUG -ggdb $(SANITIZERS)
	LDFLAGS += $(SANITIZERS)
endif

# Total source file count (progress output)
TOTAL_FILES := $(words $(SRC))

.PHONY: all
all: libs $(APPS) ## Build all libraries and all apps

.PHONY: libs
libs: $(LIB_ARCH) ## Build all libraries

$(LIB_ARCH):
	@lib=$(patsubst lib%,%,$(basename $(notdir $@))); \
	echo "[INFO] Building library $$lib"; \
	$(MAKE) --no-print-directory -C $(LIBS_DIR)/$$lib static

$(BUILD_DIR):
	@mkdir -p $(BUILD_DIR)

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR) ## Compile a shared source file
	@echo "[INFO] Compiling $<"
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD_DIR)/test_%.o: $(TEST_DIR)/%.c | $(BUILD_DIR) ## Compile a test source file
	@echo "[INFO] Compiling test $<"
	$(CC) $(CFLAGS) -c -o $@ $<

# Apps are built through an implicit rule; keep its object prerequisites around.
.PRECIOUS: $(OBJ) $(TEST_OBJ)

# Build a single app: `make vm-<app-name>`
$(APPS): vm-%: $(BUILD_DIR)/vm-% ## Build app 'vm-$*'

$(BUILD_DIR)/vm-%: $(APPS_DIR)/%/main.c $(OBJ) $(LIB_ARCH) | $(BUILD_DIR)
	@echo "[INFO] Building app 'vm-$*'"
	$(CC) $(CFLAGS) -c $(APPS_DIR)/$*/main.c -o $(BUILD_DIR)/app_$*.o
	$(CC) $(OBJ) $(BUILD_DIR)/app_$*.o $(EXTRA_OBJ) -o $@ $(LIB_ARCH) $(LDFLAGS)

# The test app links the shared VM sources with every implementation under tests/.
$(BUILD_DIR)/vm-test: $(TEST_OBJ)
$(BUILD_DIR)/vm-test: EXTRA_OBJ := $(TEST_OBJ)

-include $(DEP) $(TEST_DEP) $(patsubst %,$(BUILD_DIR)/app_%.d,$(APP_NAMES))

.PHONY: test
test: $(BUILD_DIR)/vm-test ## Build and run the test app
	@echo "[RUN] vm-test"
	@$(BUILD_DIR)/vm-test

.PHONY: clean
clean: ## Remove all build files and apps
	rm -rf $(BUILD_DIR)
	@for lib in $(LIBS); do \
		$(MAKE) --no-print-directory -C $(LIBS_DIR)/$$lib clean; \
	done

.PHONY: help
help: ## Show this help message
	@echo "Available commands:"
	@grep -h -E '^[a-zA-Z0-9_.-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-25s\033[0m %s\n", $$1, $$2}'
